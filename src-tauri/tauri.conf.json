{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amiya Atlas",
  "version": "0.2.2",
  "identifier": "org.sayori.atlas",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Amiya Atlas",
        "width": 1440,
        "height": 900,
        "minWidth": 940,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/amiya_atlas_native_host"
    ],
    "resources": {
      "../extension/*": "extension/",
      "../native-host/org.sayori.atlas.json": "native-host/org.sayori.atlas.json"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}
