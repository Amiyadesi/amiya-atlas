{
  "name": "amiya-atlas",
  "private": true,
  "version": "0.9.6",
  "type": "module",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:host": "cargo build --manifest-path native-host/Cargo.toml --release && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-native-host.ps1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "build:desktop": "npm run build:host && tauri build",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features --lib",
    "build:web": "npm run build --workspace @relakeep/web",
    "build:server": "npm run build --workspace @relakeep/server",
    "test:server": "npm test --workspace @relakeep/server"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "3d-force-graph": "^1.80.1",
    "semver": "^7.8.5",
    "svelte": "^5.38.7",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.3.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
