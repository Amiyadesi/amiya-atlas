{
  "manifest_version": 3,
  "name": "Amiya Atlas Capture",
  "version": "0.1.0",
  "description": "捕获当前网站并关联本地 Atlas 身份",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "加入 Atlas"
  },
  "background": { "service_worker": "background.js" }
}
